.env
.env.local
.env.readonly-analysis
__pycache__/
*.pyc
.venv/
node_modules/
.next/
.DS_Store
frontend/node_modules
/sources/
scripts/youtube_cookies.txt
*.log

# Local read-only mirror of Notion canonical docs — Notion is source of truth
notion-sync/

# Isolated git worktrees for session-scoped implementation work
.worktrees/

# O3 harness coordinator's durable state root (design 1.10's reserved-path
# rule) — journal, locks, terminal seals, reports. Never real-checkout
# state (tests always use tempfile.mkdtemp()); local-only if a real
# overnight run's state root ever lands under the repo instead of /tmp.
.harness/

# Subagent-driven-development scratch state (progress ledger, briefs, reports)
.superpowers/

# Consolidated local-only scratch, month-bucketed (2026-08-19 reorg) — review
# queues (closeness/reference-grounding/reference-fabrication/source-ingest-
# preview/layer3/quote-propose/generator-live-proof/calibration/backfill-run/
# position-calibration/book-chapter-live-proof/corpus-data-quality/non-
# teacher-span), run logs, and license-mapping working sets. All of it is
# either raw/copyrighted corpus excerpts (worse fit for permanent git history
# than the database it's derived from) or regeneratable run output — same
# rationale that applied to each of the ~13 individual patterns this line
# replaces. `local/_backups/` is the one exception inside this tree that IS
# git-tracked (moved from root `recovery/`, unaffected by this ignore rule
# since .gitignore never untracks an already-tracked file).
local/

# Phase 2 teacher-name guard live-run artifact (local, regenerated on demand)
scripts/teacher_name_guard_live_results.json
# Phase 2 residual prose-scan live-run artifact (local, regenerated on demand)
scripts/prose_scan_live_results.json
# Position-layer eligibility backfill cache (local, regenerated on demand --
# recovery mechanism for a failed/retried write, not a source of truth)
scripts/eligible_ids_cache.json
eligibility_dryrun_*.log
